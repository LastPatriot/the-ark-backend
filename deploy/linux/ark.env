# /etc/ark/ark.env — read by ark.service. See ARK_BACKEND.md section 3.
ARK_BIND=0.0.0.0:80
ARK_DATA_DIR=/var/lib/ark
ARK_HOSTNAME=ark
ARK_SESSION_HOURS=12
ARK_DOCS=true

# Local DNS for phones without mDNS. The router's DHCP must hand out this host as DNS.
# On systems running systemd-resolved, its stub listener already holds port 53:
# set DNSStubListener=no in /etc/systemd/resolved.conf (install.sh offers to).
ARK_DNS=false
ARK_DNS_BIND=0.0.0.0:53
# Usually the router, e.g. 192.168.1.1. Empty = first nameserver in /etc/resolv.conf.
ARK_DNS_UPSTREAM=

# Video previews: posters always (needs ffmpeg), 720p HLS when ARK_HLS=true.
# HLS transcoding is CPU-heavy; on a Raspberry Pi consider ARK_HLS=false.
ARK_FFMPEG=ffmpeg
ARK_HLS=true

# Cloud backup through rclone (configure the remote first: rclone config).
# Empty = off. Example: b2:ark-backup/church
ARK_SYNC_REMOTE=
ARK_RCLONE=rclone
ARK_SYNC_CHECK=1.1.1.1:443

# Cloudflare Tunnel is switched on from the admin API (PUT /api/v1/admin/tunnel).
ARK_CLOUDFLARED=cloudflared

RUST_LOG=the_ark=info,tower_http=warn
