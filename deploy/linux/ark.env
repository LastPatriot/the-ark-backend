# /etc/ark/ark.env — read by ark.service. See ARK_BACKEND.md section 3.
ARK_BIND=0.0.0.0:80
ARK_DATA_DIR=/var/lib/ark
ARK_HOSTNAME=ark
ARK_SESSION_HOURS=12
ARK_DOCS=true

# Local DNS for phones without mDNS. The router's DHCP must hand out this host as DNS.
# On systems running systemd-resolved, its stub listener already holds port 53:
# set DNSStubListener=no in /etc/systemd/resolved.conf (install.sh offers to).
ARK_DNS=false
ARK_DNS_BIND=0.0.0.0:53
# Usually the router, e.g. 192.168.1.1. Empty = first nameserver in /etc/resolv.conf.
ARK_DNS_UPSTREAM=

RUST_LOG=the_ark=info,tower_http=warn
